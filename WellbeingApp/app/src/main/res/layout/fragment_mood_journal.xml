<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollMoodJournal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="PILLARS 2 &amp; 3"
            android:textColor="@color/primary_sage"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="serif"
            android:text="Mood &amp; Multimedia Journal"
            android:textColor="@color/text_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- SECTION 1: MOOD TRACKER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Daily Mood Check-in"
                    android:textColor="@color/text_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Select how you feel right now:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Emoji Selection Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Radiant -->
                    <LinearLayout
                        android:id="@+id/btnMoodRadiant"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmojiRadiant"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_rounded"
                            android:gravity="center"
                            android:text="🤩"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Radiant"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Happy -->
                    <LinearLayout
                        android:id="@+id/btnMoodHappy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmojiHappy"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_rounded"
                            android:gravity="center"
                            android:text="😊"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Good"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Calm -->
                    <LinearLayout
                        android:id="@+id/btnMoodCalm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmojiCalm"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_rounded"
                            android:gravity="center"
                            android:text="😌"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Calm"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Neutral -->
                    <LinearLayout
                        android:id="@+id/btnMoodNeutral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmojiNeutral"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_rounded"
                            android:gravity="center"
                            android:text="😐"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Neutral"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Low -->
                    <LinearLayout
                        android:id="@+id/btnMoodLow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmojiLow"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_rounded"
                            android:gravity="center"
                            android:text="😔"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Low"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Stressed -->
                    <LinearLayout
                        android:id="@+id/btnMoodStressed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmojiStressed"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_rounded"
                            android:gravity="center"
                            android:text="😣"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Stressed"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mood Tags -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="What influenced your mood?"
                    android:textColor="@color/text_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbTagSleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sleep"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/cbTagExercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Workout"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/cbTagWork"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Work"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/cbTagSocial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Friends"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etMoodNote"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Add a short note about this feeling..."
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_ink"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveMood"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/primary_moss"
                    android:text="Save Daily Mood Check-In"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <!-- Mood Trends & Pattern Summary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#F8FAF9"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mood Patterns &amp; 7-Day Trend:"
                        android:textColor="@color/primary_moss"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMoodTrendSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mon: 😊 Happy | Tue: 😌 Calm | Wed: 🤩 Radiant | Thu: 😊 Good\nDominant Mood: 80% Positive • 5-day check-in streak!"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: MULTIMEDIA JOURNAL CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:text="Multimedia Journal"
                        android:textColor="@color/text_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Lock / Private Entries Toggle -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTogglePinLock"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="10dp"
                        android:text="PIN Lock"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_lock"
                        app:iconSize="14dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Text, Voice Notes &amp; Private Thoughts"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <!-- Search & Filter Bar -->
                <EditText
                    android:id="@+id/etSearchJournal"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:drawableStart="@drawable/ic_voice_note"
                    android:drawablePadding="10dp"
                    android:hint="Search journal entries by title or mood..."
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_ink"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <!-- New Journal Entry Inputs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Write a Reflection:"
                    android:textColor="@color/text_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etJournalTitle"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Entry Title (e.g. Afternoon Breakthrough)"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_ink"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etJournalBody"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top|start"
                    android:hint="What went well today? What thoughts are lingering?"
                    android:padding="12dp"
                    android:textColor="@color/text_ink"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <!-- Voice Note & Media Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Record Voice Note Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordVoice"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#FDEEE9"
                        android:text="Record Voice Note"
                        android:textColor="@color/accent_terracotta"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_voice_note"
                        app:iconSize="16dp"
                        app:iconTint="@color/accent_terracotta" />

                    <!-- Media Attachment Badge -->
                    <TextView
                        android:id="@+id/tvVoiceStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="No voice attached"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Private Checkbox -->
                <CheckBox
                    android:id="@+id/cbPrivateEntry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Private Entry (Requires PIN / Biometric to view)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Save Journal Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveJournal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/accent_clay"
                    android:text="Save Journal Entry"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <!-- Recent Journal Entries List Container -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="SAVED JOURNAL ENTRIES"
                    android:textColor="@color/primary_sage"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/layoutJournalList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

