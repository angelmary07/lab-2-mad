<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollCalculator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Card: Assignment Header & Title -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvAssignmentBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_calc_btn_normal"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LAB MAD ASSIGNMENT • DYNAMIC PROCESSING"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <!-- Required Component: TextView displaying Application Title -->
                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="serif"
                    android:text="Dynamic Numerical Processor &amp; Wellbeing Calculator"
                    android:textColor="@color/primary_forest"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Accepts two numerical values, performs operations dynamically, and changes color based on calculation."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Input Fields -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="First Numerical Input (Value 1)"
                    android:textColor="@color/text_ink"
                    android:textSize="14sp" />

                <!-- Required Component: EditText accepting user input -->
                <EditText
                    android:id="@+id/etFirstValue"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:digits="0123456789.-"
                    android:hint="Enter first number (e.g. 24.5)"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_ink"
                    android:textColorHint="@color/text_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Second Numerical Input (Value 2)"
                    android:textColor="@color/text_ink"
                    android:textSize="14sp" />

                <!-- Required Component: EditText accepting second user input -->
                <EditText
                    android:id="@+id/etSecondValue"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:digits="0123456789.-"
                    android:hint="Enter second number (e.g. 5.0)"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_ink"
                    android:textColorHint="@color/text_muted"
                    android:textSize="15sp" />

                <!-- Quick Wellbeing Presets -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.05"
                    android:text="QUICK WELLBEING PRESETS"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetSleep"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="6dp"
                        android:text="Sleep: 8.0 - 6.5"
                        android:textSize="10sp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetWater"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="6dp"
                        android:text="Water: 70 × 35"
                        android:textSize="10sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Operation Buttons Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="CHOOSE OPERATION TO PERFORM"
            android:textColor="@color/primary_sage"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Required: Button - Addition -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_moss"
                android:fontFamily="sans-serif-medium"
                android:text="+ Add"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

            <!-- Required: Button - Subtraction -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_moss"
                android:fontFamily="sans-serif-medium"
                android:text="− Subtract"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:elevation="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Required: Button - Multiplication -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_moss"
                android:fontFamily="sans-serif-medium"
                android:text="× Multiply"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

            <!-- Required: Button - Division -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_moss"
                android:fontFamily="sans-serif-medium"
                android:text="÷ Divide"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:elevation="2dp" />
        </LinearLayout>

        <!-- Card: Result Display -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/divider_line"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOperationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_calc_btn_normal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="READY"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvColorIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Default Color"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Required Component: TextView displaying the result dynamically -->
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingMultiplier="1.1"
                    android:text="Calculated result will appear dynamically here"
                    android:textColor="@color/text_ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Detailed calculation breakdown -->
                <TextView
                    android:id="@+id/tvCalculationDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Select two values and click any operation (+, −, ×, ÷)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Required Component: Button to clear all entered values -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/calc_clear_bg"
            android:fontFamily="sans-serif-medium"
            android:text="Clear All Entered Values &amp; Result"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:elevation="1dp" />

        <!-- Assignment Checklist Guide Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#F3F7F5"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/primary_mint"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assignment Criteria Checklist:"
                    android:textColor="@color/primary_forest"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="✓ Title TextView &amp; 2 Numerical EditText inputs\n✓ +, −, ×, ÷ Operation Buttons with clicked color highlight\n✓ Dynamic Result TextView changing color per operation\n✓ Clear Button resets inputs, result, and colors\n✓ Toast on empty inputs &amp; division by zero handling\n✓ Numerical validation &amp; operation name displayed"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

