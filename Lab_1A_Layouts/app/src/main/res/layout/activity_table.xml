<?xml version="1.0" encoding="utf-8"?>
<!-- LAYOUT 4: TableLayout -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTable"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="← Back to Hub"
                android:textColor="@color/primary_sage"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/primary_moss"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="LAYOUT 4: TABLELAYOUT"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:text="Weekly Sleep Log Matrix"
            android:textColor="@color/text_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Constructed using TableLayout and TableRows with stretchColumns to arrange medical records."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- The TableLayout -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:stretchColumns="0,1,2,3">

            <!-- Header Row -->
            <TableRow android:background="#ECE5D8" android:paddingVertical="8dp">
                <TextView android:text="Day" android:textStyle="bold" android:textColor="@color/text_ink" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="Bed" android:textStyle="bold" android:textColor="@color/text_ink" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="Wake" android:textStyle="bold" android:textColor="@color/text_ink" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="Hours" android:textStyle="bold" android:textColor="@color/text_ink" android:gravity="center" android:textSize="12sp" />
            </TableRow>

            <!-- Data Row 1 -->
            <TableRow android:paddingVertical="8dp">
                <TextView android:text="Mon" android:textColor="@color/text_ink" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="11:00 PM" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="07:00 AM" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="8.0h" android:textStyle="bold" android:textColor="@color/primary_moss" android:gravity="center" android:textSize="12sp" />
            </TableRow>

            <View android:layout_height="1dp" android:background="@color/divider_line" />

            <!-- Data Row 2 -->
            <TableRow android:paddingVertical="8dp">
                <TextView android:text="Tue" android:textColor="@color/text_ink" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="11:30 PM" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="07:15 AM" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="7.8h" android:textStyle="bold" android:textColor="@color/primary_moss" android:gravity="center" android:textSize="12sp" />
            </TableRow>

            <View android:layout_height="1dp" android:background="@color/divider_line" />

            <!-- Data Row 3 -->
            <TableRow android:paddingVertical="8dp">
                <TextView android:text="Wed" android:textColor="@color/text_ink" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="10:45 PM" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="07:00 AM" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="8.2h" android:textStyle="bold" android:textColor="@color/primary_moss" android:gravity="center" android:textSize="12sp" />
            </TableRow>

            <View android:layout_height="1dp" android:background="@color/divider_line" />

            <!-- Data Row 4 -->
            <TableRow android:paddingVertical="8dp">
                <TextView android:text="Thu" android:textColor="@color/text_ink" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="12:00 AM" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="06:45 AM" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="12sp" />
                <TextView android:text="6.8h" android:textStyle="bold" android:textColor="@color/accent_clay" android:gravity="center" android:textSize="12sp" />
            </TableRow>

        </TableLayout>

        <!-- Dynamic Calculation Inputs -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Log New Sleep Entry:"
            android:textColor="@color/text_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etBedTime"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit"
                android:hint="Bed: 23:00"
                android:paddingHorizontal="10dp"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etWakeTime"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit"
                android:hint="Wake: 07:15"
                android:paddingHorizontal="10dp"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnComputeDuration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary_moss"
            android:text="Calculate &amp; Log Table Row" />

        <TextView
            android:id="@+id/tvDurationResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Calculated duration will appear here"
            android:textColor="@color/primary_moss"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>

