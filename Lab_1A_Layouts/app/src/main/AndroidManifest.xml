<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lab1A">

        <!-- Launcher Hub -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Layout 1: ConstraintLayout -->
        <activity android:name=".ConstraintLayoutActivity" android:exported="false" />

        <!-- Layout 2: LinearLayout -->
        <activity android:name=".LinearLayoutActivity" android:exported="false" />

        <!-- Layout 3: RelativeLayout -->
        <activity android:name=".RelativeLayoutActivity" android:exported="false" />

        <!-- Layout 4: TableLayout -->
        <activity android:name=".TableLayoutActivity" android:exported="false" />

        <!-- Layout 5: FrameLayout -->
        <activity android:name=".FrameLayoutActivity" android:exported="false" />

    </application>

</manifest>

